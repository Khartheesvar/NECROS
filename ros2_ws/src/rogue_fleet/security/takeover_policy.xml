<policy version="0.2.0">
  <!-- Scenario 3 "Rogue Coordinator" SROS2 access-control policy (dedicated, isolated
       from Scenario 1). Generated from the live graph with `ros2 security
       generate_policy`. Load-bearing rule: ONLY the fleet_coordinator identity may
       PUBLISH /amrN/goal_pose; the robots may only SUBSCRIBE to goal_pose. Under
       enforcement a rogue impersonator has no certificate permitting it to publish
       goals, so the impersonation attack is rejected at the middleware layer. The
       robots expose no cmd_vel surface at all. -->
  <enclaves>
    <enclave path="/">
      <profiles>
        <profile node="amr" ns="/amr1">
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/get_type_description</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics subscribe="ALLOW">
            <topic>goal_pose</topic>
          </topics>
          <topics publish="ALLOW">
            <topic>/parameter_events</topic>
            <topic>/rosout</topic>
            <topic>odom</topic>
            <topic>status</topic>
          </topics>
        </profile>
        <profile node="amr" ns="/amr2">
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/get_type_description</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics subscribe="ALLOW">
            <topic>goal_pose</topic>
          </topics>
          <topics publish="ALLOW">
            <topic>/parameter_events</topic>
            <topic>/rosout</topic>
            <topic>odom</topic>
            <topic>status</topic>
          </topics>
        </profile>
        <profile node="fleet_coordinator" ns="/">
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/get_type_description</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics subscribe="ALLOW">
            <topic>/amr1/odom</topic>
            <topic>/amr2/odom</topic>
          </topics>
          <topics publish="ALLOW">
            <topic>/amr1/goal_pose</topic>
            <topic>/amr2/goal_pose</topic>
            <topic>/fleet/state</topic>
            <topic>parameter_events</topic>
            <topic>rosout</topic>
          </topics>
        </profile>
        <profile node="telemetry_bridge" ns="/">
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/get_type_description</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics subscribe="ALLOW">
            <topic>/amr1/odom</topic>
            <topic>/amr2/odom</topic>
            <topic>/fleet/state</topic>
          </topics>
          <topics publish="ALLOW">
            <topic>parameter_events</topic>
            <topic>rosout</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>
  </enclaves>
</policy>
