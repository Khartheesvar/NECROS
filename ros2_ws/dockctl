#!/usr/bin/env bash
# dockctl — operator control for the Scenario 2 dock AMR's ROS stack.
# Mirrors fleetctl: start/stop/status/restart. Security (defend phase) is enabled
# the same way — provision a keystore, set ROS_SECURITY_* env, then `dockctl start`.
source /opt/ros/jazzy/setup.bash 2>/dev/null
[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash 2>/dev/null

LAUNCH="ros2 launch rogue_fleet dock.launch.py"
LOGFILE=/var/log/dock.log
PGIDFILE=/run/dock.pgid
PIDPAT="dock.launch.py|rogue_fleet/lib/rogue_fleet/dock"

is_running() { pgrep -f "$PIDPAT" >/dev/null 2>&1; }

case "${1:-status}" in
  status)
    if is_running; then
      [ "${ROS_SECURITY_ENABLE:-false}" = "true" ] && echo "dock: RUNNING (security: ENFORCED — SROS2)" \
        || ([ -f /run/dock.secure ] && echo "dock: RUNNING (security: ENFORCED — SROS2)" || echo "dock: RUNNING (security: OFF — open bus)")
    else echo "dock: STOPPED"; fi ;;
  stop)
    if is_running; then
      echo "stopping dock ROS stack..."
      [ -f "$PGIDFILE" ] && { kill -TERM -- "-$(cat $PGIDFILE)" 2>/dev/null; sleep 2; kill -KILL -- "-$(cat $PGIDFILE)" 2>/dev/null; rm -f "$PGIDFILE"; }
      pkill -TERM -f "$PIDPAT" 2>/dev/null; sleep 1; pkill -KILL -f "$PIDPAT" 2>/dev/null
      rm -f /run/dock.secure; echo "dock stopped."
    else echo "dock already stopped."; fi ;;
  start)
    if is_running; then echo "dock already running (use 'dockctl restart')."; exit 1; fi
    mkdir -p "$(dirname "$LOGFILE")"
    if [ "${ROS_SECURITY_ENABLE:-false}" = "true" ]; then echo "starting dock with SROS2 ENFORCED..."; touch /run/dock.secure
    else echo "starting dock (open bus — no security)..."; rm -f /run/dock.secure; fi
    setsid $LAUNCH > "$LOGFILE" 2>&1 &
    echo $! > "$PGIDFILE"; sleep 6
    if is_running; then echo "dock started. (logs: $LOGFILE)"; else echo "dock FAILED:"; tail -8 "$LOGFILE"; exit 1; fi ;;
  restart) "$0" stop; "$0" start ;;
  *) echo "usage: dockctl {status|stop|start|restart}"; exit 1 ;;
esac
