#!/usr/bin/env bash
# saboteurctl — operator control for the Scenario 6 saboteur AMR's ROS stack.
# Mirrors fleetctl/dockctl: start/stop/status/restart. Security (defend phase) is
# enabled the same way — provision a keystore, set ROS_SECURITY_* env, then
# `saboteurctl start`.
source /opt/ros/jazzy/setup.bash 2>/dev/null
[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash 2>/dev/null

LAUNCH="ros2 launch rogue_fleet saboteur.launch.py"
LOGFILE=/var/log/saboteur.log
PGIDFILE=/run/saboteur.pgid
PIDPAT="saboteur.launch.py|rogue_fleet/lib/rogue_fleet/saboteur"

is_running() { pgrep -f "$PIDPAT" >/dev/null 2>&1; }

case "${1:-status}" in
  status)
    if is_running; then
      [ "${ROS_SECURITY_ENABLE:-false}" = "true" ] && echo "saboteur: RUNNING (security: ENFORCED — SROS2)" \
        || ([ -f /run/saboteur.secure ] && echo "saboteur: RUNNING (security: ENFORCED — SROS2)" || echo "saboteur: RUNNING (security: OFF — open bus)")
    else echo "saboteur: STOPPED"; fi ;;
  stop)
    if is_running; then
      echo "stopping saboteur ROS stack..."
      [ -f "$PGIDFILE" ] && { kill -TERM -- "-$(cat $PGIDFILE)" 2>/dev/null; sleep 2; kill -KILL -- "-$(cat $PGIDFILE)" 2>/dev/null; rm -f "$PGIDFILE"; }
      pkill -TERM -f "$PIDPAT" 2>/dev/null; sleep 1; pkill -KILL -f "$PIDPAT" 2>/dev/null
      rm -f /run/saboteur.secure; echo "saboteur stopped."
    else echo "saboteur already stopped."; fi ;;
  start)
    if is_running; then echo "saboteur already running (use 'saboteurctl restart')."; exit 1; fi
    mkdir -p "$(dirname "$LOGFILE")"
    if [ "${ROS_SECURITY_ENABLE:-false}" = "true" ]; then echo "starting saboteur with SROS2 ENFORCED..."; touch /run/saboteur.secure
    else echo "starting saboteur (open bus — no security)..."; rm -f /run/saboteur.secure; fi
    setsid $LAUNCH > "$LOGFILE" 2>&1 &
    echo $! > "$PGIDFILE"; sleep 6
    if is_running; then echo "saboteur started. (logs: $LOGFILE)"; else echo "saboteur FAILED:"; tail -8 "$LOGFILE"; exit 1; fi ;;
  restart) "$0" stop; "$0" start ;;
  *) echo "usage: saboteurctl {status|stop|start|restart}"; exit 1 ;;
esac
